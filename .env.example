# Required
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — web search tool activates automatically once set
TAVILY_API_KEY=

# Optional — observability via LangSmith (see docs/TechSpec_v1.1.md §4.4).
# Leave unset to keep tracing off; no code changes needed either way.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Required for login (PRD_v1.1.md Goal 8) — signs session tokens. Any long
# random string; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
